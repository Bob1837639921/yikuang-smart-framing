:host{display:block}
.mini-header{width:100%;height:48px;box-sizing:border-box;display:grid;grid-template-columns:44px minmax(0,1fr) auto;column-gap:8px;align-items:center;text-align:center}
.mini-header.inset-header{padding:0 14px 0 16px}
.back-button{width:38px;height:38px;margin:0;padding:0;border:0;border-radius:50%;background:#fff4cf;display:grid;place-items:center;box-sizing:border-box}
.back-arrow{position:relative;width:18px;height:18px}
.back-arrow::before{content:"";position:absolute;left:1px;top:8px;width:16px;height:2px;border-radius:2px;background:#6d5a35}
.back-arrow::after{content:"";position:absolute;left:1px;top:4px;width:8px;height:8px;border-left:2px solid #6d5a35;border-bottom:2px solid #6d5a35;transform:rotate(45deg)}
.header-title{justify-self:center;min-width:0;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px;font-weight:800}
.header-step{justify-self:end;display:flex;align-items:center;gap:5px;min-width:59px;height:29px;box-sizing:border-box;padding:0 9px;border:1px solid rgba(226,180,49,.25);border-radius:15px;background:linear-gradient(180deg,#fff9e3,#fff2c9);color:#9e813e;white-space:nowrap;position:relative;z-index:2;box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 2px 6px rgba(177,130,25,.08)}
.header-step-label{font-size:8px;line-height:1;color:#b09355}
.header-step-value{font-size:11px;font-weight:900;line-height:1;color:#8c6d2f;letter-spacing:.2px}
.back-button{transition:transform .2s cubic-bezier(.2,.8,.25,1),box-shadow .2s ease,background-color .2s ease;box-shadow:0 3px 0 rgba(220,190,111,.42)}
.back-button:active{transform:translateY(2px) scale(.93);box-shadow:0 1px 0 rgba(220,190,111,.42)}
.back-button.button-hover{transform:translateY(2px) scale(.93);box-shadow:0 1px 0 rgba(220,190,111,.42)}
.back-arrow{transition:transform .2s ease}
.back-button:active .back-arrow{transform:translateX(-2px)}
.dark-header .back-button{background:rgba(255,255,255,.14)}
.dark-header .back-arrow::before{background:#fff}
.dark-header .back-arrow::after{border-color:#fff}
.dark-header .header-title{color:#fff}
.dark-header .header-step{border-color:rgba(255,255,255,.28);background:rgba(255,255,255,.12);box-shadow:inset 0 1px 0 rgba(255,255,255,.18)}
.dark-header .header-step-label{color:rgba(255,255,255,.66)}
.dark-header .header-step-value{color:#f6d474}
