:host{display:block;width:102px;height:58px;min-width:102px;min-height:58px;box-sizing:border-box;overflow:visible}
.mat-corner-preview{position:relative;width:100%;height:100%;box-sizing:border-box;overflow:hidden;border:1px solid #dfc579;border-radius:11px;background:#4c321d;box-shadow:0 3px 8px rgba(91,55,9,.12);perspective:260px;transform-style:preserve-3d;touch-action:manipulation;transition:transform .25s ease}
.mat-corner-preview:active{transform:scale(.98)}
.mat-corner-layer,.mat-corner-art{position:absolute;display:block;background-repeat:repeat;background-size:44px auto;box-shadow:inset 0 0 0 1px rgba(25,22,18,.24)}
.mat-corner-layer{box-sizing:border-box;transform:translateZ(var(--mat-depth,2px));box-shadow:inset 0 0 0 1px rgba(25,22,18,.24),0 1px 0 rgba(91,59,18,.2),0 2px var(--mat-depth,2px) rgba(64,40,11,.15)}
.mat-corner-layer{pointer-events:none;transition:box-shadow .2s ease,transform .2s ease}
.mat-corner-hit-zone{position:absolute;display:block;pointer-events:auto;background:transparent}
.mat-corner-layer.active{box-shadow:inset 0 0 0 2px #e6ad15,0 1px 0 rgba(91,59,18,.2),0 2px var(--mat-depth,2px) rgba(64,40,11,.15);animation:mat-corner-chip-pop .36s cubic-bezier(.2,.85,.25,1)}
.mat-corner-art{z-index:10;background:#8f4e27;pointer-events:none}
.mat-corner-active-ring{position:absolute;z-index:12;box-sizing:border-box;border:2px solid #e6ad15;border-radius:3px;box-shadow:0 0 0 1px rgba(255,255,255,.75),0 0 0 3px rgba(230,173,21,.18);pointer-events:none;transition:inset .25s cubic-bezier(.2,.8,.25,1),opacity .2s ease}
.corner-pulse{animation:mat-corner-pulse .36s cubic-bezier(.2,.85,.25,1)}
@keyframes mat-corner-chip-pop{0%{transform:scale(.94)}65%{transform:scale(1.04)}100%{transform:scale(1)}}
@keyframes mat-corner-pulse{0%{transform:scale(.96)}65%{transform:scale(1.04)}100%{transform:scale(1)}}
