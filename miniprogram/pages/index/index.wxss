.editor-preview-head{position:relative;z-index:10;width:100%;height:43px;flex:0 0 43px;padding-top:2px;background:linear-gradient(180deg,rgba(255,249,234,.98),rgba(255,249,234,.88) 72%,rgba(255,249,234,0))}
