/* The rail face owns the exact 45-degree cut. Its overflow mask prevents the
 * repeated texture from crossing the inner/outer corner seam when rotated. */
.frame3d-bar::before{display:none}
.frame3d-face{position:absolute;inset:0;z-index:2;display:block;overflow:hidden;background:linear-gradient(135deg,#e1b66b 0%,#9d5f2c 30%,#5b2c12 100%);border:1px solid rgba(67,31,7,.24);box-shadow:inset 0 1px 1px rgba(255,255,255,.48),inset 0 -2px 3px rgba(52,26,4,.26)}
.frame3d-bar.top .frame3d-face{clip-path:polygon(0 0,100% 0,calc(100% - var(--frame-border,13px)) 100%,var(--frame-border,13px) 100%)}
.frame3d-bar.bottom .frame3d-face{clip-path:polygon(var(--frame-border,13px) 0,calc(100% - var(--frame-border,13px)) 0,100% 100%,0 100%)}
.frame3d-bar.left .frame3d-face{clip-path:polygon(0 0,100% var(--frame-border,13px),100% calc(100% - var(--frame-border,13px)),0 100%)}
.frame3d-bar.right .frame3d-face{clip-path:polygon(0 var(--frame-border,13px),100% 0,100% 100%,0 calc(100% - var(--frame-border,13px)))}
.frame3d-face .frame3d-texture{clip-path:none!important}

