/* Frame-only 3D preview. The artwork is a flat image; the frame bars expose
 * front, side and back faces while the user drags the model. */
.frame3d-stage{width:100%;height:320px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;perspective:900px;touch-action:none;overflow:visible}
.frame3d-model{width:220px;height:307px;position:relative;transform-style:preserve-3d;transition:transform .18s ease-out;will-change:transform}
.frame3d-stage.landscape .frame3d-model{width:300px;height:214px}
.frame3d-back{position:absolute;inset:0;border:var(--frame-border,13px) solid;box-sizing:border-box;transform:translateZ(-9px);box-shadow:inset 0 0 0 2px rgba(255,255,255,.14)}
.frame3d-art{position:absolute;inset:var(--frame-border,13px);z-index:1;box-sizing:border-box;transform:translateZ(var(--mat-thickness,1px));overflow:hidden}
.frame3d-artwork{position:absolute;display:block;z-index:8;overflow:hidden}.frame3d-artwork image{width:100%;height:100%;display:block}
.frame3d-mat-layer{position:absolute;display:block;background-repeat:repeat;background-size:88px auto;box-shadow:inset 0 0 0 1px rgba(45,40,30,.18),0 1px 2px rgba(40,31,18,.18)}
.frame3d-glass{position:absolute;inset:calc(var(--frame-border,13px) - 1px);z-index:3;transform:translateZ(16px);border:1px solid rgba(255,255,255,.72);background:linear-gradient(135deg,rgba(255,255,255,.3),rgba(255,255,255,0) 42%,rgba(255,255,255,.1));pointer-events:none}
.frame3d-bar{position:absolute;z-index:4;display:block;border:1px solid;box-sizing:border-box;transform:translateZ(18px);transform-style:preserve-3d;background:linear-gradient(135deg,#e1b66b 0%,#9d5f2c 30%,#6a3518 100%);box-shadow:inset 0 1px 1px rgba(255,255,255,.4),inset 0 -2px 3px rgba(52,26,4,.22);overflow:visible}
.frame3d-bar::before{content:"";position:absolute;inset:0;pointer-events:none}
.frame3d-bar::after{content:"";position:absolute;display:block;background:linear-gradient(90deg,rgba(255,255,255,.18),rgba(54,25,6,.7) 34%,rgba(54,25,6,.2) 72%,rgba(255,255,255,.12));box-shadow:inset 0 0 4px rgba(0,0,0,.28)}
.frame3d-bar.top,.frame3d-bar.bottom{left:0;right:0;height:var(--frame-border,13px)}.frame3d-bar.top{top:0}.frame3d-bar.bottom{bottom:0}
.frame3d-bar.top::after{left:0;top:100%;width:100%;height:var(--frame-depth,26px);transform-origin:top;transform:rotateX(-90deg)}
.frame3d-bar.bottom::after{left:0;bottom:100%;width:100%;height:var(--frame-depth,26px);transform-origin:bottom;transform:rotateX(90deg)}
.frame3d-bar.top,.frame3d-bar.bottom{background:var(--frame-texture,none) center 54% / 100% auto no-repeat,linear-gradient(135deg,#e1b66b 0%,#9d5f2c 30%,#6a3518 100%);background-blend-mode:multiply,normal}
.frame3d-bar.left,.frame3d-bar.right{top:0;bottom:0;width:var(--frame-border,13px);background:var(--frame-profile,none) center / auto 100% no-repeat,var(--frame-texture,none) center / auto 100% no-repeat,linear-gradient(180deg,#f1c675,#9d5f2c 28%,#5a2d13 72%,#a96e2c);background-blend-mode:multiply,multiply,normal}.frame3d-bar.left{left:0}.frame3d-bar.right{right:0}
.frame3d-bar.left::before,.frame3d-bar.right::before{background:linear-gradient(180deg,rgba(255,255,255,.18),rgba(65,29,8,.22) 45%,rgba(0,0,0,.34));transform:none;opacity:.72;mix-blend-mode:multiply}
.frame3d-bar.top,.frame3d-bar.bottom{background-size:100% auto,auto;background-repeat:no-repeat}
.frame3d-bar.left::before,.frame3d-bar.right::before{background-size:100% 100%;background-repeat:no-repeat}
.frame3d-bar.left::after{left:100%;top:0;width:var(--frame-depth,26px);height:100%;transform-origin:left;transform:rotateY(90deg)}
.frame3d-bar.right::after{right:100%;top:0;width:var(--frame-depth,26px);height:100%;transform-origin:right;transform:rotateY(-90deg)}
.frame3d-corner{position:absolute;z-index:6;width:calc(var(--frame-border,13px) * 1.65);height:calc(var(--frame-border,13px) * 1.65);background-image:var(--frame-corner,none);background-size:cover;background-position:center;box-shadow:0 1px 3px rgba(45,22,4,.42);transform:translateZ(21px);pointer-events:none}.frame3d-corner.top-left{top:-1px;left:-1px}.frame3d-corner.top-right{top:-1px;right:-1px;transform:translateZ(21px) rotateY(180deg)}.frame3d-corner.bottom-right{right:-1px;bottom:-1px;transform:translateZ(21px) rotate(180deg)}.frame3d-corner.bottom-left{left:-1px;bottom:-1px;transform:translateZ(21px) rotateX(180deg)}
