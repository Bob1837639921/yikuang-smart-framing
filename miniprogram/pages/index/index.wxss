/* Coherent 45-degree mitres. Corner reference photos are intentionally not
 * rendered as overlays because they break as soon as the frame rotates. */
.frame3d-bar{background:transparent!important;border:0;box-shadow:none;overflow:visible}
.frame3d-bar::before{content:"";position:absolute;inset:0;z-index:2;display:block;pointer-events:none;border:1px solid rgba(67,31,7,.24);box-shadow:inset 0 1px 1px rgba(255,255,255,.48),inset 0 -2px 3px rgba(52,26,4,.26);background:linear-gradient(135deg,#e1b66b 0%,#9d5f2c 30%,#5b2c12 100%)}
.frame3d-bar.top::before{clip-path:polygon(0 0,100% 0,calc(100% - var(--frame-border,13px)) 100%,var(--frame-border,13px) 100%)}
.frame3d-bar.bottom::before{clip-path:polygon(var(--frame-border,13px) 0,calc(100% - var(--frame-border,13px)) 0,100% 100%,0 100%)}
.frame3d-bar.left::before{clip-path:polygon(0 0,100% var(--frame-border,13px),100% calc(100% - var(--frame-border,13px)),0 100%);background-size:auto 100%,auto}
.frame3d-bar.right::before{clip-path:polygon(0 var(--frame-border,13px),100% 0,100% 100%,0 calc(100% - var(--frame-border,13px)));background-size:auto 100%,auto}
.frame3d-texture{position:absolute;z-index:3;display:block;pointer-events:none;background-image:var(--frame-texture,none);background-size:auto 100%;background-position:left center;background-repeat:repeat-x;mix-blend-mode:multiply}
.frame3d-bar.top .frame3d-texture{inset:0;clip-path:polygon(0 0,100% 0,calc(100% - var(--frame-border,13px)) 100%,var(--frame-border,13px) 100%)}
.frame3d-bar.bottom .frame3d-texture{inset:0;clip-path:polygon(var(--frame-border,13px) 0,calc(100% - var(--frame-border,13px)) 0,100% 100%,0 100%);transform:rotate(180deg)}
.frame3d-bar.left .frame3d-texture,.frame3d-bar.right .frame3d-texture{left:50%;top:50%;width:var(--frame-model-height);height:var(--frame-border,13px);transform-origin:center}
.frame3d-bar.left .frame3d-texture{transform:translate(-50%,-50%) rotate(-90deg);clip-path:polygon(0 0,100% 0,calc(100% - var(--frame-border,13px)) 100%,var(--frame-border,13px) 100%)}
.frame3d-bar.right .frame3d-texture{transform:translate(-50%,-50%) rotate(90deg);clip-path:polygon(var(--frame-border,13px) 0,calc(100% - var(--frame-border,13px)) 0,100% 100%,0 100%)}
.frame3d-bar::after{z-index:1;background:linear-gradient(90deg,rgba(255,255,255,.16),rgba(55,25,6,.74) 28%,rgba(55,25,6,.3) 72%,rgba(255,255,255,.1));border:1px solid rgba(45,20,4,.18)}
.frame3d-art{box-shadow:0 0 0 1px rgba(86,60,24,.2),inset 0 0 16px rgba(91,65,28,.12)}
.frame3d-glass{background:linear-gradient(118deg,rgba(255,255,255,.34) 0%,rgba(255,255,255,.08) 18%,transparent 31%,transparent 69%,rgba(255,255,255,.13) 82%,transparent 100%);box-shadow:inset 0 0 14px rgba(255,255,255,.18)}
.frame3d-model{filter:drop-shadow(0 20px 16px rgba(54,34,10,.27)) drop-shadow(0 5px 4px rgba(54,34,10,.12))}
