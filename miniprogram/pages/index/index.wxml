<view class="mini-app" style="padding-top:{{topInset}}px">

  <block wx:if="{{screen === 'home'}}">
    <scroll-view class="app-scroll" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="false">
      <view class="app-screen oneframe usable-home">
        <view class="brand-row">
          <view class="brand" bindlongpress="openAdmin"><view class="brand-mark"><view></view><view></view><view></view><view></view></view><text>一框</text></view>
          <button class="profile-button" bindtap="openSaved"><view class="person-icon"></view></button>
        </view>
        <view class="headline-block">
          <text class="eyebrow">装裱前，先让它试一试</text>
          <text class="home-title">给它一只<text>刚刚好的框</text></text>
          <text class="headline-subtitle">拍照、校正，马上看到装裱效果</text>
        </view>
        <view class="demo-hero">
          <image class="hero-art" src="/assets/hero-frame-world.jpg" mode="aspectFill"></image>
          <view class="orbit-line"></view>
          <button class="float-entry f1" bindtap="openPicker"><text class="entry-icon">▧</text><text>作品展</text></button>
          <button class="float-entry f2" bindtap="openMaterials"><text class="entry-icon">▱</text><text>框料库</text></button>
          <button class="float-entry f3" bindtap="openSaved"><text class="entry-icon">♙</text><text>我的方案</text></button>
        </view>
        <view class="actions home-actions">
          <button class="try-button" bindtap="startCapture"><text class="button-icon">▣</text><text>拍照试装</text></button>
          <button class="upload-button" bindtap="startCapture"><text class="upload-icon">⇧</text><text>从相册选择</text></button>
        </view>
        <view class="section-title"><view></view><text>测试作品</text><button bindtap="openPicker">查看全部 →</button></view>
        <scroll-view class="sample-carousel" scroll-x enhanced show-scrollbar="false">
          <view class="sample-row">
            <button class="sample-card" wx:for="{{samples}}" wx:key="id" data-id="{{item.id}}" bindtap="selectArt">
              <image src="{{item.src}}" mode="aspectFill"></image>
              <view class="sample-copy"><text>{{item.title}}</text><text>{{item.type}} · 点击试装</text></view>
            </button>
          </view>
        </scroll-view>
        <text class="mini-note">微信小程序体验版 · 测试数据不会产生真实订单</text>
      </view>
    </scroll-view>
  </block>

  <block wx:elif="{{screen === 'capture'}}">
    <view class="app-screen camera-page">
      <common-header title="拍摄作品" step="1 / 4" dark="{{true}}" inset="{{true}}" bind:back="onBack"></common-header>
      <view class="camera-view">
        <image src="/assets/test-ink.jpg" mode="aspectFill"></image>
        <view class="camera-guide"><view></view><view></view><view></view><view></view><text>让作品四角落在框内</text></view>
        <view class="camera-tip">光线均匀 · 避免反光 · 保留四周背景</view>
      </view>
      <view class="camera-actions">
        <button bindtap="chooseImage"><text class="action-icon">⇧</text><text>相册</text></button>
        <button class="shutter" bindtap="useDemo"><view></view></button>
        <button bindtap="useDemo"><text class="action-icon">✦</text><text>示例</text></button>
      </view>
    </view>
  </block>

  <block wx:elif="{{screen === 'picker'}}">
    <scroll-view class="app-screen flow-page" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="false">
      <common-header title="选择测试作品" bind:back="onBack"></common-header>
      <view class="page-intro"><text>先选一幅作品</text><text>皱宣纸案例会先体验去皱整理。</text></view>
      <view class="case-grid">
        <button wx:for="{{samples}}" wx:key="id" class="case-card" data-id="{{item.id}}" bindtap="selectArt">
          <image src="{{item.src}}" mode="aspectFill"></image><view><text>{{item.title}}</text><text>{{item.type}}</text></view><text class="case-arrow">›</text>
        </button>
      </view>
    </scroll-view>
  </block>

  <block wx:elif="{{screen === 'crop'}}">
    <view class="app-screen crop-page">
      <common-header title="校正作品边缘" step="2 / 4" dark="{{true}}" inset="{{true}}" bind:back="onBack"></common-header>
      <view class="crop-help"><text>拖动四个黄点贴合作品边缘</text><text>系统已经自动找边，你可以手动修正。</text></view>
      <view class="crop-board" catchtouchmove="movePoint" bindtouchend="stopPointDrag" bindtouchcancel="stopPointDrag">
        <image class="crop-image {{cropRotated ? 'crop-rotated' : ''}}" src="{{art.src}}" mode="aspectFill"></image>
        <view class="crop-dim" style="clip-path:polygon({{cropPolygon}});-webkit-clip-path:polygon({{cropPolygon}})"></view>
        <view class="crop-line" wx:for="{{lineStyles}}" wx:key="index" style="{{item}}"></view>
        <view class="crop-point" wx:for="{{pointStyles}}" wx:key="index" style="{{item}}" data-index="{{index}}" bindtouchstart="startPointDrag"></view>
      </view>
      <view class="crop-tools"><button bindtap="rotateCrop">↻ 旋转</button><button bindtap="resetCrop">✧ 重新识别</button></view>
      <button class="primary-wide crop-confirm" bindtap="confirmCrop">✓ 确认并拉正</button>
    </view>
  </block>

  <block wx:elif="{{screen === 'processing'}}">
    <view class="app-screen processing-page">
      <view class="processing-frame"><view></view><view></view><view></view><view></view></view>
      <text>正在拉正作品</text><text>校正透视、裁掉背景、生成清晰预览…</text>
      <view class="process-track"><view></view></view>
    </view>
  </block>

  <block wx:elif="{{screen === 'repair'}}">
    <view class="app-screen repair-page">
      <common-header title="作品整理" step="3 / 5" bind:back="onBack"></common-header>
      <view class="repair-alert"><text class="repair-alert-icon">✣</text><view><text>检测到明显褶皱</text><text>建议轻度整理，保留笔触和纸张纹理。</text></view></view>
      <view class="compare-stage" catchtouchstart="startCompare" catchtouchmove="moveCompare" bindtouchend="stopCompare" bindtouchcancel="stopCompare">
        <image src="{{art.src}}" mode="aspectFill"></image>
        <view class="clean-layer" style="width:{{compare}}%"><image src="{{repairLevel === 'flat' ? '/assets/test-dewrinkled-real.jpg' : '/assets/test-dewrinkled-light.jpg'}}" mode="aspectFill"></image></view>
        <view class="compare-line" style="left:{{compare}}%"><text>↔</text></view>
        <text class="before-label">原貌</text><text class="after-label">整理后</text>
      </view>
      <slider class="compare-range" min="0" max="100" value="{{compare}}" activeColor="#e3a713" block-color="#e3a713" block-size="20" bindchanging="onCompareChange" bindchange="onCompareChange"></slider>
      <view class="repair-levels">
        <button class="{{repairLevel === 'original' ? 'active' : ''}}" data-level="original" bindtap="setRepairLevel"><text>保留原貌</text><text>只拉正，不去皱</text></button>
        <button class="{{repairLevel === 'light' ? 'active' : ''}}" data-level="light" bindtap="setRepairLevel"><text>轻度去皱</text><text>推荐 · 保留纸纹</text></button>
        <button class="{{repairLevel === 'flat' ? 'active' : ''}}" data-level="flat" bindtap="setRepairLevel"><text>模拟托裱</text><text>更平整的效果预览</text></button>
      </view>
      <button class="primary-wide repair-confirm" bindtap="confirmRepair">使用这个效果 ›</button>
    </view>
  </block>

  <block wx:elif="{{screen === 'editor'}}">
    <view class="app-screen editor-shell editor-mode-{{editorMode}} {{editorExpanded ? 'editor-expanded' : 'editor-compact'}}">
      <common-header title="试装效果" step="3 / 4" inset="{{true}}" bind:back="onBack"></common-header>
      <view class="editor-preview">
        <view class="editor-preview-head">
          <view class="editor-caption"><view class="editor-caption-live"><view class="live-dot"></view><text>实时预览</text></view><view wx:if="{{frame.geometry}}" class="editor-caption-meta">{{frame.geometry.profileType}} · {{frame.geometry.widthMm}} × {{frame.geometry.depthMm}}mm</view><text class="editor-caption-art">{{art.title}}</text></view>
        </view>
        <view class="frame3d-stage {{art.id === 'photo' || art.id === 'abstract' ? 'landscape' : 'portrait'}}" catchtouchstart="startFrameRotate" catchtouchmove="moveFrameRotate" bindtouchend="stopFrameRotate" bindtouchcancel="stopFrameRotate" binddbltap="resetFrameRotate" bindwheel="onFrameWheel">
          <canvas type="2d" id="frame3dCanvas" class="frame3d-canvas"></canvas>
          <view class="frame3d-model" style="transform:rotateX({{frameRotateX}}deg) rotateY({{frameRotateY}}deg) scale({{frameZoom}});box-shadow:0 18px 28px {{frame.shadow}};{{frameTextureStyle}}">
            <view class="frame3d-back" style="{{frameTextureStyle}}"></view>
            <view class="frame3d-shell frame3d-shell-top"><view class="frame3d-shell-texture"></view></view>
            <view class="frame3d-shell frame3d-shell-right"><view class="frame3d-shell-texture"></view></view>
            <view class="frame3d-shell frame3d-shell-bottom"><view class="frame3d-shell-texture"></view></view>
            <view class="frame3d-shell frame3d-shell-left"><view class="frame3d-shell-texture"></view></view>
            <view class="frame3d-art"><view wx:for="{{mat ? matLayerViews : []}}" wx:key="id" class="frame3d-mat-layer" style="{{item.previewStyle}}"><view class="frame3d-mat-side frame3d-mat-side-top"></view><view class="frame3d-mat-side frame3d-mat-side-right"></view><view class="frame3d-mat-side frame3d-mat-side-bottom"></view><view class="frame3d-mat-side frame3d-mat-side-left"></view></view><view class="frame3d-artwork" style="{{mat ? matImageInsetStyle : 'inset:0px'}}"><image src="{{editorSrc}}" mode="aspectFill"></image></view><view wx:if="{{mat && editorMode === 'mat'}}" class="frame3d-mat-selection" style="{{activeMatPreviewStyle}}"></view></view>
            <view class="frame3d-glass"></view>
            <view class="frame3d-bar top" style="{{frameTextureStyle}}"><view class="frame3d-face"><view class="frame3d-texture"></view></view></view>
            <view class="frame3d-bar right" style="{{frameTextureStyle}}"><view class="frame3d-face"><view class="frame3d-texture"></view></view></view>
            <view class="frame3d-bar bottom" style="{{frameTextureStyle}}"><view class="frame3d-face"><view class="frame3d-texture"></view></view></view>
            <view class="frame3d-bar left" style="{{frameTextureStyle}}"><view class="frame3d-face"><view class="frame3d-texture"></view></view></view>
          </view>
        </view>
        <view class="editor-preview-actions"><view class="frame3d-zoom"><text class="frame3d-zoom-hint">拖动旋转 · 双指/滚轮缩放</text><text class="frame3d-zoom-value">{{frameZoomPercent}}%</text><button class="frame3d-reset {{resetPulse ? 'reset-pulse' : ''}}" catchtap="resetFrameRotate" hover-class="none">复位</button></view><view class="change-art" role="button" aria-label="更换作品" data-action="change-art" catchtap="openEditorPicker"><text class="change-art-icon">▧</text><text>换作品</text></view></view>
      </view>
      <view class="editor-drawer">
        <button wx:if="{{editorMode === 'mat'}}" class="editor-drawer-handle" bindtap="toggleEditorExpanded" hover-class="none" aria-label="展开或收起卡纸编辑"><view></view></button>
        <view wx:else class="editor-drawer-handle editor-drawer-handle-static"><view></view></view>
        <view class="editor-tabs"><button class="{{editorMode === 'frame' ? 'active' : ''}}" data-mode="frame" bindtap="setEditorMode">画框</button><button class="{{editorMode === 'mat' ? 'active' : ''}}" data-mode="mat" bindtap="setEditorMode">卡纸</button><button class="{{editorMode === 'size' ? 'active' : ''}}" data-mode="size" bindtap="setEditorMode">尺寸</button></view>
        <view wx:if="{{editorMode === 'frame'}}" class="editor-panel frame-panel">
          <scroll-view class="option-carousel" scroll-x enhanced show-scrollbar="false"><view class="frame-option-row"><button wx:for="{{frames}}" wx:key="id" class="frame-option {{frame.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectFrame"><view class="frame-option-swatch"><image wx:if="{{item.assets && item.assets.swatch}}" src="{{item.assets.swatch}}" mode="aspectFill"></image><view wx:else style="background:{{item.tone}};border-color:{{item.edge}}"></view></view><view class="frame-option-copy"><text>{{item.name}}</text><text>¥{{item.pricePerMeter}}/米</text></view><text wx:if="{{frame.id === item.id}}" class="frame-option-check">✓</text></button></view></scroll-view>
        </view>
        <view wx:elif="{{editorMode === 'mat'}}" class="mat-editor-shell">
          <view wx:if="{{!editorExpanded}}" class="mat-compact-summary">
            <view class="mat-focus-card mat-compact-focus-card"><view class="mat-focus-copy"><view class="mat-compact-focus-head"><button class="switch {{mat ? 'on' : ''}}" bindtap="toggleMat"><view></view></button><view class="mat-compact-focus-label"><text>{{mat ? activeMatLayerLabel : '未使用卡纸'}}</text><text class="mat-live-badge">实时</text></view><button class="mat-expand-action" bindtap="toggleEditorExpanded" hover-class="none"><text>展开编辑</text><text>›</text></button></view><text>{{activeMatLayerIndex === 0 ? '外层控制主卡纸留边' : '内层控制相邻卡纸露边'}}</text><text>上下同步、左右同步，两组可分别调整</text></view><mat-corner-preview layers="{{matLayerViews}}" active-index="{{activeMatLayerIndex}}" art-style="{{matCornerArtStyle}}" active-ring-style="{{activeMatCornerStyle}}" pulse="{{cornerPulse}}" bind:matcycle="cycleMatLayer" bind:matlayerselect="selectMatLayer"></mat-corner-preview></view>
          </view>
          <view wx:else class="mat-controls-clip"><scroll-view class="mat-controls" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view class="mat-detail-heading"><view><text>编辑卡纸</text><text>选层后调整材质与露边</text></view><view class="mat-heading-actions"><button class="switch {{mat ? 'on' : ''}}" bindtap="toggleMat"><view></view></button><button class="mat-collapse-action" bindtap="toggleEditorExpanded" hover-class="none">收起</button></view></view>
            <view class="mat-layer-toolbar"><scroll-view class="mat-layer-tabs" scroll-x enhanced show-scrollbar="false"><view class="mat-layer-tabs-inner"><button wx:for="{{matLayers}}" wx:key="id" class="{{activeMatLayerIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectMatLayer">第{{index + 1}}层 <text>上下{{item.topBottomMm}} · 左右{{item.leftRightMm}}mm</text></button></view></scroll-view><button wx:if="{{matLayers.length < 3}}" class="mat-layer-add" bindtap="addMatLayer">＋</button><button wx:if="{{matLayers.length > 1}}" class="mat-layer-remove" bindtap="removeMatLayer">移除</button></view>
            <view class="mat-focus-card"><view class="mat-focus-copy"><view><text>{{activeMatLayerLabel}}</text><text class="mat-live-badge">实时</text></view><text>{{activeMatLayerIndex === 0 ? '外层控制主卡纸留边' : '内层控制相邻卡纸露边'}}</text><text>上下同步、左右同步，两组可分别调整</text></view><mat-corner-preview layers="{{matLayerViews}}" active-index="{{activeMatLayerIndex}}" art-style="{{matCornerArtStyle}}" active-ring-style="{{activeMatCornerStyle}}" pulse="{{cornerPulse}}" bind:matcycle="cycleMatLayer" bind:matlayerselect="selectMatLayer"></mat-corner-preview></view>
            <view class="mat-section-heading"><text>卡纸材质</text><text>{{selectedMat.name}} · {{selectedMat.thicknessMm}}mm</text></view>
            <scroll-view class="mat-material-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}"><view class="mat-material-row"><button wx:for="{{mats}}" wx:key="id" class="mat-material-option {{selectedMat.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectMatMaterial"><view class="mat-material-swatch" style="background-color:{{item.color}};background-image:{{item.texture ? 'url(' + item.texture + ')' : 'none'}}"></view><view><text>{{item.name}}</text><text>厚度 {{item.thicknessMm}}mm</text></view><view wx:if="{{selectedMat.id === item.id}}" class="mat-selected-mark">✓</view></button></view></scroll-view>
            <view class="mat-direction-widths"><view class="mat-width-row"><view class="mat-width-heading"><text>上下{{activeMatLayerIndex === 0 ? '总留边' : '露边'}}</text><text>{{matTopBottomMm}}mm</text></view><view class="mat-width-control"><button data-axis="topBottom" data-direction="-1" bindtap="adjustMatWidth">−</button><view class="mat-slider-clip"><slider data-axis="topBottom" min="{{activeMatMin}}" max="{{activeMatMax}}" step="{{activeMatStep}}" value="{{matTopBottomMm}}" activeColor="#e8ab13" bindchange="onMatWidthChange"></slider></view><button data-axis="topBottom" data-direction="1" bindtap="adjustMatWidth">＋</button></view></view><view class="mat-width-row"><view class="mat-width-heading"><text>左右{{activeMatLayerIndex === 0 ? '总留边' : '露边'}}</text><text>{{matLeftRightMm}}mm</text></view><view class="mat-width-control"><button data-axis="leftRight" data-direction="-1" bindtap="adjustMatWidth">−</button><view class="mat-slider-clip"><slider data-axis="leftRight" min="{{activeMatMin}}" max="{{activeMatMax}}" step="{{activeMatStep}}" value="{{matLeftRightMm}}" activeColor="#e8ab13" bindchange="onMatWidthChange"></slider></view><button data-axis="leftRight" data-direction="1" bindtap="adjustMatWidth">＋</button></view></view></view>
          </scroll-view></view>
        </view>
        <view wx:else class="editor-panel size-panel"><view class="size-panel-head"><text>作品实际尺寸</text><text>用于生成真实比例的画框</text></view><view class="size-controls"><label><text>宽度</text><view><input type="number" value="{{width}}" bindinput="onWidthChange"/><text>cm</text></view></label><text class="size-times">×</text><label><text>高度</text><view><input type="number" value="{{height}}" bindinput="onHeightChange"/><text>cm</text></view></label></view></view>
        <view class="editor-summary"><view><text>预计参考价</text><text>¥{{total}}</text></view><button class="primary-wide" bindtap="savePlan">保存方案 ›</button></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{screen === 'confirm'}}">
    <scroll-view class="app-screen flow-page confirm-page" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="false">
      <common-header title="确认方案" step="4 / 4" bind:back="onBack"></common-header>
      <view class="success-orbit">✓</view><text class="confirm-title">{{done ? '询价已提交' : '这套搭配很适合它'}}</text><text class="confirm-subtitle">{{done ? '门店会按测试尺寸给出最终报价。' : '价格以门店实物测量为准。'}}</text>
      <view class="plan-card"><image src="{{editorSrc}}" mode="aspectFill"></image><view><text>{{art.title}}</text><text>{{frame.name}} · {{mat ? '上下' + matTopBottomMm + ' / 左右' + matLeftRightMm + 'mm 卡纸' : '无卡纸'}}</text><text>{{width}} × {{height}} cm</text><text>参考价 ¥{{total}}</text></view></view>
      <view wx:if="{{done}}" class="contact-box"><text>一框装裱工作室</text><text>测试门店 · 预计10分钟内回复</text></view>
      <button wx:if="{{done}}" class="primary-wide" bindtap="goHome">返回首页</button>
      <block wx:else><button class="primary-wide" bindtap="submitPlan">提交门店询价</button><button class="secondary-wide" bindtap="onBack">← 继续调整</button></block>
    </scroll-view>
  </block>

  <block wx:elif="{{screen === 'admin'}}">
    <scroll-view class="app-screen flow-page admin-page" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="false">
      <common-header title="素材管理" bind:back="onBack"></common-header>
      <view wx:if="{{!adminAuthorized}}" class="admin-gate">
        <text class="admin-kicker">管理员入口</text>
        <text class="admin-title">用 UUID 管理真实框料</text>
        <text class="admin-copy">体验版先使用 UUID 门禁，不接登录页面。正式上线时应改为服务端签发的短期令牌。</text>
        <input class="admin-input" value="{{adminUuidInput}}" placeholder="输入管理员 UUID" bindinput="onAdminUuidInput"></input>
        <button class="primary-wide" bindtap="verifyAdminUuid">验证并进入</button>
        <text class="admin-demo">体验 UUID：oneframe-admin-demo</text>
        <text wx:if="{{adminError}}" class="admin-error">{{adminError}}</text>
      </view>
      <view wx:else class="admin-console">
        <view class="admin-status"><text>管理员模式</text><text>UUID 已授权 · 本机配置</text></view>
        <view class="admin-form">
          <text class="admin-section-title">新增并生成 3D 框料</text>
          <text class="admin-hint">系统不会自动猜尺寸。封面图只用于列表展示；正面、侧面负责 3D 材质外观，白底截面轮廓图负责记录真实型面。</text>
          <view class="admin-upload-grid">
            <button class="admin-upload admin-upload-small" data-kind="coverImage" bindtap="chooseMaterialImage"><image wx:if="{{adminDraft.coverImage}}" src="{{adminDraft.coverImage}}" mode="aspectFill"></image><text wx:else>＋ 封面展示图（必传）</text></button>
            <button class="admin-upload admin-upload-small" data-kind="frontImage" bindtap="chooseMaterialImage"><image wx:if="{{adminDraft.frontImage}}" src="{{adminDraft.frontImage}}" mode="aspectFill"></image><text wx:else>＋ 正面纹理（必传）</text></button>
            <button class="admin-upload admin-upload-small" data-kind="profileImage" bindtap="chooseMaterialImage"><image wx:if="{{adminDraft.profileImage}}" src="{{adminDraft.profileImage}}" mode="aspectFill"></image><text wx:else>＋ 侧面纹理（必传）</text></button>
            <button class="admin-upload admin-upload-small" data-kind="sectionImage" bindtap="chooseMaterialImage"><image wx:if="{{adminDraft.sectionImage}}" src="{{adminDraft.sectionImage}}" mode="aspectFit"></image><text wx:else>＋ 截面轮廓（必传）</text></button>
          </view>
          <input class="admin-input" value="{{adminDraft.name}}" placeholder="框料名称" bindinput="onAdminNameInput"></input>
          <view class="admin-price-field"><view><text>框料单价</text><text>必填 · 元/米</text></view><view class="admin-price-input"><text>¥</text><input type="digit" value="{{adminDraft.pricePerMeter}}" placeholder="168" bindinput="onAdminPriceInput"></input><text>/米</text></view></view>
          <view class="admin-picker-row"><picker mode="selector" range="{{lineCategories}}" value="{{adminLineCategoryIndex}}" bindchange="onAdminLineCategoryChange"><view class="admin-select">分类：{{adminLineCategoryLabel}} ▾</view></picker><picker mode="selector" range="{{adminLineSubcategories}}" value="{{adminLineSubcategoryIndex}}" bindchange="onAdminLineSubcategoryChange"><view class="admin-select">系列：{{adminLineSubcategoryLabel}} ▾</view></picker></view>
          <view class="admin-picker-row"><picker mode="selector" range="{{materialTypes}}" value="{{adminMaterialTypeIndex}}" bindchange="onAdminMaterialTypeChange"><view class="admin-select">表面：{{adminMaterialTypeLabel}} ▾</view></picker><picker mode="selector" range="{{profileTypes}}" value="{{adminProfileTypeIndex}}" bindchange="onAdminProfileTypeChange"><view class="admin-select">截面：{{adminProfileTypeLabel}} ▾</view></picker></view>
          <view class="admin-dimension-grid"><input class="admin-input" type="number" value="{{adminDraft.widthMm}}" placeholder="框宽 mm" bindinput="onAdminWidthInput"></input><input class="admin-input" type="number" value="{{adminDraft.depthMm}}" placeholder="框深 mm" bindinput="onAdminDepthInput"></input><input class="admin-input" type="number" value="{{adminDraft.innerLipMm}}" placeholder="内沿 mm" bindinput="onAdminInnerLipInput"></input><input class="admin-input" type="number" value="{{adminDraft.bevelMm}}" placeholder="倒角 mm" bindinput="onAdminBevelInput"></input></view>
          <view class="admin-side-width-field"><view><text>侧面显示宽度</text><text>控制旋转时可见的侧面厚度，不改变报价</text></view><input class="admin-input" type="number" value="{{adminDraft.sideWidthMm}}" placeholder="例如 18" bindinput="onAdminSideWidthInput"></input><text>mm</text></view>
          <text class="admin-hint">颜色以上传纹理为准；框宽控制正面边框，框深/侧面显示宽度控制立体厚度，内沿控制画面被压住的内侧边，倒角控制边缘明暗过渡。编辑器中的作品宽高会按实际比例适配。</text>
          <button class="primary-wide" disabled="{{adminGenerating}}" bindtap="saveFrameMaterial">{{adminGenerating ? '正在生成 3D…' : '生成 3D 并发布'}}</button>
          <view wx:if="{{adminGenerating}}" class="admin-progress"><view class="admin-progress-head"><text>正在生成</text><text>{{adminProgress}}%</text></view><view class="admin-progress-track"><view style="width:{{adminProgress}}%"></view></view><text>{{adminNotice}}</text></view>
          <view wx:if="{{adminResult}}" class="admin-result-card"><view class="admin-result-status"><text class="admin-result-icon">✓</text><view><text>{{adminResult.cached ? '生成完成，已命中本地缓存' : '生成成功，已保存并发布'}}</text><text>3D 框体已经写入本机配置。</text></view></view><text class="admin-result-meta">缓存 key：{{adminResult.cacheKey}}</text><text class="admin-result-meta">保存位置：local-cache/frame-scenes/{{adminResult.cacheKey}}/</text><button bindtap="openGeneratedPreview">查看旋转效果</button></view>
          <text wx:if="{{adminNotice && !adminGenerating && !adminResult}}" class="admin-success">{{adminNotice}}</text>
          <text wx:if="{{adminError}}" class="admin-error">{{adminError}}</text>
        </view>
        <view class="admin-form"><text class="admin-section-title">已配置框料</text><view class="admin-material-list"><view wx:for="{{frames}}" wx:key="id" class="admin-material-row"><view><text>{{item.name}}</text><text>{{item.lineCategory || '其他材质'}} / {{item.lineSubcategory || '未细分'}} · ¥{{item.pricePerMeter}}/米</text></view><button wx:if="{{item.source === 'admin-upload'}}" data-id="{{item.id}}" bindtap="deleteFrameMaterial">移除</button></view></view></view>
        <view class="admin-form"><text class="admin-section-title">新增卡纸</text><text class="admin-hint">只需上传一张正面纹理图。基础色与切边色会在小程序本地自动识别，厚度用于层叠深度，不参与报价。</text><button class="admin-upload admin-mat-upload" bindtap="chooseMatTexture"><image wx:if="{{adminMatDraft.textureImage}}" src="{{adminMatDraft.textureImage}}" mode="aspectFill"></image><text wx:else>＋ 卡纸正面纹理（必传）</text></button><input class="admin-input" value="{{adminMatDraft.name}}" placeholder="卡纸名称" bindinput="onAdminMatNameInput"></input><text class="admin-hint">自动识别基础色：{{adminMatDraft.color}}</text><view class="admin-dimension-grid"><input class="admin-input" type="digit" value="{{adminMatDraft.thicknessMm}}" placeholder="厚度 mm" bindinput="onAdminMatThicknessInput"></input><input class="admin-input" type="number" value="{{adminMatDraft.defaultTopBottomMm}}" placeholder="默认上下留边 mm" bindinput="onAdminMatTopBottomInput"></input><input class="admin-input" type="number" value="{{adminMatDraft.defaultLeftRightMm}}" placeholder="默认左右留边 mm" bindinput="onAdminMatLeftRightInput"></input></view><button class="primary-wide" bindtap="saveMatMaterial">保存并发布卡纸</button><text wx:if="{{adminMatNotice}}" class="admin-success">{{adminMatNotice}}</text></view>
      </view>
    </scroll-view>
  </block>

  <block wx:elif="{{screen === 'materials'}}">
    <view class="app-screen material-library-page">
      <common-header title="框料库" inset="{{true}}" bind:back="onBack"></common-header>
      <scroll-view class="material-catalog-scroll" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="false">
        <view class="material-library-intro"><view><text>像翻样册一样挑框</text><text>看转角、宽度与材质，再去试装</text></view><button bindtap="openAdmin">管理框料</button></view>
        <scroll-view class="material-filter-scroll" scroll-x enhanced show-scrollbar="false"><view class="material-filters"><button wx:for="{{frameFilters}}" wx:key="*this" class="{{materialFilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="setMaterialFilter">{{item}}</button></view></scroll-view>
        <scroll-view wx:if="{{frameSubfilters.length}}" class="material-filter-scroll material-subfilter-scroll" scroll-x enhanced show-scrollbar="false"><view class="material-filters"><button wx:for="{{frameSubfilters}}" wx:key="*this" class="{{materialSubfilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="setMaterialSubfilter">{{item}}</button></view></scroll-view>
        <view class="material-grid"><button wx:for="{{visibleFrames}}" wx:key="id" class="material-card {{frame.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectMaterial"><view class="material-card-image"><image wx:if="{{item.assets && item.assets.catalog}}" src="{{item.assets.catalog}}" mode="aspectFill"></image><view wx:else class="material-card-fallback" style="background:{{item.tone}}"></view><text wx:if="{{frame.id === item.id}}" class="material-selected-badge">已选</text></view><view class="material-card-copy"><text>{{item.name}}</text><view><text>{{item.geometry.widthMm}}mm · {{item.lineSubcategory || item.materialLabel}}</text><text>¥{{item.pricePerMeter}}/米</text></view></view></button></view>
        <view wx:if="{{!visibleFrames.length}}" class="material-empty">这个分类还没有框料</view>
        <view class="material-scroll-spacer"></view>
      </scroll-view>
      <view class="material-selection-bar"><view class="material-selection-swatch"><image wx:if="{{frame.assets && frame.assets.catalog}}" src="{{frame.assets.catalog}}" mode="aspectFill"></image><view wx:else style="background:{{frame.tone}}"></view></view><view class="material-selection-copy"><text>已选：{{frame.name}}</text><text>¥{{frame.pricePerMeter}}/米 · 按实际用量计价</text></view><button bindtap="previewSelectedMaterial">查看 3D 试装</button></view>
    </view>
  </block>

  <block wx:elif="{{screen === 'saved'}}">
    <scroll-view class="app-screen flow-page" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="false">
      <common-header title="我的方案" bind:back="onBack"></common-header>
      <view class="empty-state"><text class="empty-icon">▱</text><text>还没有保存方案</text><text>完成一次试装后，搭配和尺寸会保存在这里。</text><button class="primary-wide" bindtap="startCapture">＋ 新建试装方案</button></view>
    </scroll-view>
  </block>
</view>
